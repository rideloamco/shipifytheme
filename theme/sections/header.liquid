<header class="site-header" role="banner">
  <a href="{{ routes.root_url }}" class="site-header__logo" aria-label="{{ shop.name }}">
    LOAM<span>CO.</span>
  </a>

  <nav class="site-header__nav" aria-label="Main navigation">
    {%- for link in linklists['main-menu'].links -%}
      <a
        href="{{ link.url }}"
        class="{% if link.active %}active{% endif %}"
        {% if link.active %}aria-current="page"{% endif %}
      >
        {{ link.title }}
      </a>
    {%- else -%}
      <a href="{{ routes.root_url }}collections/all">Shop</a>
      <a href="{{ routes.root_url }}pages/about">About</a>
      <a href="{{ routes.root_url }}pages/why-loam">Why Loam</a>
      {%- if blogs['journal'] -%}
        <a href="{{ blogs['journal'].url }}">Journal</a>
      {%- endif -%}
      <a href="{{ routes.root_url }}pages/reviews">Reviews</a>
      <a href="{{ routes.root_url }}pages/ambassadors">Ambassadors</a>
    {%- endfor -%}
  </nav>

  <div class="site-header__actions">
    <a href="{{ routes.search_url }}" class="site-header__icon-btn" aria-label="Search">
      <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>
      </svg>
    </a>

    <a href="{{ routes.account_url }}" class="site-header__icon-btn" aria-label="Account">
      <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>
      </svg>
    </a>

    <button
      class="site-header__icon-btn"
      data-action="open-cart"
      aria-label="Open cart. {{ cart.item_count }} item{% if cart.item_count != 1 %}s{% endif %}"
    >
      <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/>
        <path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/>
      </svg>
      <span class="cart-count" aria-hidden="true" {% if cart.item_count == 0 %}style="display:none"{% endif %}>
        {{ cart.item_count }}
      </span>
    </button>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": []
}
{% endschema %}

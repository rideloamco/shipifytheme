<section class="section-newsletter">
  <div class="section-newsletter__inner">
    <div>
      <p class="section-newsletter__eyebrow">{{ section.settings.eyebrow | default: 'JOIN THE COMMUNITY' }}</p>
      <h2 class="section-newsletter__heading">{{ section.settings.heading | default: 'Join the dirt cult.' }}</h2>
    </div>

    <div>
      <p class="section-newsletter__body">{{ section.settings.body | default: 'Trail tips, product drops, and exclusive offers. Straight to your inbox. No marketing fluff.' }}</p>

      <div class="js-newsletter-wrapper">
        {%- form 'customer', id: 'newsletter-form', class: 'newsletter-form js-newsletter-form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <input
            type="email"
            name="contact[email]"
            placeholder="{{ section.settings.placeholder | default: 'rider@trails.uk' }}"
            aria-label="Email address"
            required
          >
          <button type="submit">JOIN</button>
        {%- endform -%}
      </div>

      <div class="newsletter-socials">
        {%- if section.settings.instagram_url != blank -%}
          <a href="{{ section.settings.instagram_url }}" aria-label="Instagram" target="_blank" rel="noopener noreferrer">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="3" width="18" height="18" rx="4"/><circle cx="12" cy="12" r="4"/>
              <circle cx="17.5" cy="6.5" r="0.6" fill="currentColor"/>
            </svg>
          </a>
        {%- else -%}
          <a href="#" aria-label="Instagram">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="3" width="18" height="18" rx="4"/><circle cx="12" cy="12" r="4"/>
              <circle cx="17.5" cy="6.5" r="0.6" fill="currentColor"/>
            </svg>
          </a>
        {%- endif -%}

        {%- if section.settings.tiktok_url != blank -%}
          <a href="{{ section.settings.tiktok_url }}" aria-label="TikTok" target="_blank" rel="noopener noreferrer">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M14 4v10a4 4 0 1 1-4-4"/><path d="M14 4a4 4 0 0 0 4 4"/>
            </svg>
          </a>
        {%- else -%}
          <a href="#" aria-label="TikTok">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M14 4v10a4 4 0 1 1-4-4"/><path d="M14 4a4 4 0 0 0 4 4"/>
            </svg>
          </a>
        {%- endif -%}

        {%- if section.settings.youtube_url != blank -%}
          <a href="{{ section.settings.youtube_url }}" aria-label="YouTube" target="_blank" rel="noopener noreferrer">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="6" width="18" height="12" rx="2"/><path d="m10 9 5 3-5 3z" fill="currentColor"/>
            </svg>
          </a>
        {%- else -%}
          <a href="#" aria-label="YouTube">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="6" width="18" height="12" rx="2"/><path d="m10 9 5 3-5 3z" fill="currentColor"/>
            </svg>
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter — Join the Cult",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "JOIN THE COMMUNITY" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Join the dirt cult." },
    { "type": "textarea", "id": "body", "label": "Body text", "default": "Trail tips, product drops, and exclusive offers. Straight to your inbox. No marketing fluff." },
    { "type": "text", "id": "placeholder", "label": "Input placeholder", "default": "rider@trails.uk" },
    { "type": "url", "id": "instagram_url", "label": "Instagram URL" },
    { "type": "url", "id": "tiktok_url", "label": "TikTok URL" },
    { "type": "url", "id": "youtube_url", "label": "YouTube URL" }
  ],
  "presets": [
    { "name": "Newsletter — Join the Cult" }
  ]
}
{% endschema %}

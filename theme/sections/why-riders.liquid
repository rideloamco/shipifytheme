<section id="why" class="section-why">
  <div class="section-why__header">
    <p class="eyebrow">{{ section.settings.eyebrow | default: 'WHY RIDERS CHOOSE LOAM CO.' }}</p>
    <h2 class="section-why__heading">{{ section.settings.heading | default: 'Four things, done properly.' }}</h2>
  </div>

  <div class="section-why__grid">
    {%- for block in section.blocks -%}
      <div class="section-why__item" {{ block.shopify_attributes }}>
        <div class="section-why__num">{{ block.settings.number | default: forloop.index | prepend: '0' | slice: -2, 2 }}</div>
        <div class="section-why__title">{{ block.settings.title }}</div>
        <div class="section-why__desc">{{ block.settings.description }}</div>
      </div>
    {%- else -%}
      {%- assign defaults = '01,TRAIL-TESTED DURABILITY,Built to last in mud, rain, and dust. Tested in the Tweed Valley before it ever ships.|02,BREATHABLE COMFORT,Engineered fabrics designed for long climbs and longer descents.|03,MODERN STYLE,Ride gear that looks the part on the bike — and at the pub afterwards.|04,SUSTAINABLE CHOICE,Recycled fabrics. Plastic-free packaging. No bullshit greenwashing.' | split: '|' -%}
      {%- for item in defaults -%}
        {%- assign parts = item | split: ',' -%}
        <div class="section-why__item">
          <div class="section-why__num">{{ parts[0] }}</div>
          <div class="section-why__title">{{ parts[1] }}</div>
          <div class="section-why__desc">{{ parts[2] }}</div>
        </div>
      {%- endfor -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Why Riders",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "WHY RIDERS CHOOSE LOAM CO." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Four things, done properly." }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        { "type": "text", "id": "number", "label": "Number", "default": "01" },
        { "type": "text", "id": "title", "label": "Title", "default": "TRAIL-TESTED DURABILITY" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "Built to last in mud, rain, and dust." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Why Riders",
      "blocks": [
        { "type": "feature", "settings": { "number": "01", "title": "TRAIL-TESTED DURABILITY", "description": "Built to last in mud, rain, and dust. Tested in the Tweed Valley before it ever ships." } },
        { "type": "feature", "settings": { "number": "02", "title": "BREATHABLE COMFORT", "description": "Engineered fabrics designed for long climbs and longer descents." } },
        { "type": "feature", "settings": { "number": "03", "title": "MODERN STYLE", "description": "Ride gear that looks the part on the bike — and at the pub afterwards." } },
        { "type": "feature", "settings": { "number": "04", "title": "SUSTAINABLE CHOICE", "description": "Recycled fabrics. Plastic-free packaging. No bullshit greenwashing." } }
      ]
    }
  ]
}
{% endschema %}

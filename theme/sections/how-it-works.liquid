<section id="how" class="section-how">
  <p class="eyebrow">{{ section.settings.eyebrow | default: 'HOW IT WORKS' }}</p>
  <h2 class="section-how__heading">{{ section.settings.heading | default: 'Four steps. No gatekeeping.' }}</h2>

  <div class="section-how__grid">
    {%- for block in section.blocks -%}
      <div class="section-how__item" {{ block.shopify_attributes }}>
        <div class="section-how__num">{{ block.settings.number | default: forloop.index | prepend: '0' | slice: -2, 2 }}</div>
        <div class="section-how__title">{{ block.settings.title }}</div>
        <div class="section-how__desc">{{ block.settings.description }}</div>
      </div>
    {%- else -%}
      {%- assign steps = '01,APPLY,Fill out the form below. Tell us about your riding and your audience.|02,GET YOUR LINK,Approved riders get a custom code, tracking dashboard, and free welcome kit.|03,MAKE CONTENT,Post, ride, share. Your audience gets 10% off. You earn on every sale.|04,GET PAID,Monthly bank transfer. No minimum threshold. No invoices. No faff.' | split: '|' -%}
      {%- for step in steps -%}
        {%- assign parts = step | split: ',' -%}
        <div class="section-how__item">
          <div class="section-how__num">{{ parts[0] }}</div>
          <div class="section-how__title">{{ parts[1] }}</div>
          <div class="section-how__desc">{{ parts[2] }}</div>
        </div>
      {%- endfor -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "How It Works",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "HOW IT WORKS" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Four steps. No gatekeeping." }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "number", "label": "Number", "default": "01" },
        { "type": "text", "id": "title", "label": "Title", "default": "APPLY" },
        { "type": "textarea", "id": "description", "label": "Description" }
      ]
    }
  ],
  "presets": [
    { "name": "How It Works" }
  ]
}
{% endschema %}
